{
  "name": "artedu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd admin-console && npm run dev",
    "dev:worker": "cd apps/api && npm run worker",
    "db:up": "node scripts/database.mjs up",
    "db:check": "node scripts/database.mjs check",
    "db:repair": "node scripts/database.mjs repair",
    "db:down": "node scripts/database.mjs down",
    "db:migrate": "cd apps/api && npm run db:migrate",
    "db:seed": "cd apps/api && npm run db:seed",
    "catalog:verify": "npm --prefix apps/api run catalog:verify",
    "catalog:plan": "npm --prefix apps/api run catalog:plan",
    "catalog:install": "npm --prefix apps/api run catalog:install",
    "catalog:rollback": "npm --prefix apps/api run catalog:rollback",
    "db:prepare": "npm run db:up && npm run db:migrate && npm run db:seed && npm --prefix apps/api run showcase:install && npm run catalog:install",
    "check": "npm run check:api && npm run check:api:test && npm run check:atomic && npm run check:web && npm run check:morph && npm run test:case-import && node --test scripts/reliability.test.mjs scripts/start-case-local.test.mjs",
    "check:atomic": "npm --prefix apps/api run build && node --test apps/api/dist/modules/atomic/atomic.test.js admin-console/tests/atomic-learning.test.mjs admin-console/tests/atomic-attachments.test.mjs admin-console/tests/atomic-particles.test.mjs",
    "test:case-import": "node --test scripts/import-community-cases.test.mjs apps/api/scripts/install-community-showcase.test.mjs apps/api/scripts/install-morph-catalog.test.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:chat:live": "node scripts/verify-demo-chat.mjs",
    "test:documents:live": "node scripts/verify-document-generation.mjs",
    "test:images:live": "node scripts/verify-image-generation.mjs",
    "check:api": "cd apps/api && npm run typecheck",
    "check:api:test": "npm --prefix apps/api run test:security",
    "check:web": "cd admin-console && npm run build && npm run test:sites && npm run test:chat && npm run test:platform",
    "check:morph": "npm --prefix admin-console run test:morph && npm --prefix apps/api run test:morph"
  }
}
