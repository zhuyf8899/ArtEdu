FROM node:22.23.4-alpine AS build

WORKDIR /app

# RAG 使用 pdftotext；PDF 导出则由 Chromium 在同一受限容器中完成。
RUN apk add --no-cache poppler-utils chromium font-noto-cjk tesseract-ocr tesseract-ocr-data-chi_sim tesseract-ocr-data-eng

COPY apps/api/package.json apps/api/package-lock.json ./apps/api/
COPY apps/api/vendor ./apps/api/vendor
RUN cd apps/api && npm ci

COPY apps/api ./apps/api
COPY migrations ./migrations
COPY seed ./seed
# Curated summaries used by the idempotent knowledge-atlas import, no private source files.
COPY admin-console/package.json ./admin-console/package.json
COPY admin-console/src/curriculumAtlas.js admin-console/src/courseKnowledge.js ./admin-console/src/
# Content installer verifies the same public covers served by the web image.
COPY admin-console/public/morph-v17 ./admin-console/public/morph-v17

WORKDIR /app/apps/api
RUN npm run build

ENV ARTEDU_REPOSITORY_ROOT=/app
EXPOSE 4000

CMD ["node", "dist/main.js"]
