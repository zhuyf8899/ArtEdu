FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /srv

# 只装推理所需的运行时：onnxruntime + tokenizers + FastAPI。
# 不装 torch/transformers，镜像和常驻内存都保持在 staging 机器可承受的范围内。
COPY services/embedding/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY services/embedding/app.py ./

# 模型通过只读卷挂载到 /model，运行时参数由 docker-compose.staging.yml 注入。
ENV MODEL_DIR=/model

EXPOSE 8080

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--timeout-keep-alive", "30"]
