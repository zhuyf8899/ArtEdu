# 仅供本地开发；生产环境必须由密钥管理服务注入配置。
DATABASE_URL=postgresql://artedu:artedu_dev_only@localhost:5433/artedu
# 开发联调时，前端必须显式发送 x-user-id；不再提供默认管理员身份。
ENABLE_DEVELOPMENT_AUTH=true
# 真实模型适配器接入前必须保持 false，避免 worker 误领任务后将其标记为失败。
MODEL_EXECUTION_ENABLED=false
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4173
