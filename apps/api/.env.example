# 仅供本地开发；生产环境必须由密钥管理服务注入配置。
DATABASE_URL=postgresql://artedu:artedu_dev_only@localhost:5432/artedu
# 本地账号登录不依赖学校 SSO。迁移和种子数据完成后，以环境变量提供用户 ID 和密码，再运行 npm run auth:provision-local。
ENABLE_LOCAL_AUTH=true
# 仅在开发或测试环境临时设为 true，才允许生成四个本地测试账号；不要用于生产环境。
ARTEDU_ALLOW_TEST_ACCOUNTS=false
LOCAL_SESSION_DAYS=7
# 本地会话在未活动达到该时长后失效；绝对有效期仍由 LOCAL_SESSION_DAYS 控制。
LOCAL_SESSION_IDLE_HOURS=12
LOCAL_BRIDGE_TOKEN_DAYS=30
# 仅限 JPEG、PNG、WebP 与 PDF；上传内容保存到 API 私有目录，不作为静态文件暴露。
ENABLE_FILE_UPLOADS=true
UPLOAD_ROOT=./data/uploads
MODEL_EXECUTION_ENABLED=false
# JSON array of OpenAI-compatible providers. Secrets stay in the referenced env vars.
MODEL_PROVIDERS_JSON=[]
# Example: [{"id":"school-chat","baseUrl":"https://model.example.edu/v1","model":"school-chat-v1","capabilities":["chat"],"apiKeyEnv":"SCHOOL_CHAT_API_KEY"}]
SCHOOL_CHAT_API_KEY=
# DeepSeek 使用 OpenAI-compatible Chat Completions；id 必须与数据库 model_configs.id 一致。
# MODEL_PROVIDERS_JSON=[{"id":"model-deepseek-v4-flash","baseUrl":"https://api.deepseek.com","model":"deepseek-v4-flash","capabilities":["chat","image","pattern","webpage"],"apiKeyEnv":"DEEPSEEK_API_KEY","timeoutMs":60000}]
DEEPSEEK_API_KEY=
# Comma-separated terms. High-risk terms block the run; alert terms create an admin alert.
AGENT_ALERT_KEYWORDS=
AGENT_BLOCK_KEYWORDS=
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4173
