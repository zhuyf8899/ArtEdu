# Copy this to .env in the repository root on the server. Do not commit the copy.
ARTEDU_POSTGRES_PASSWORD=replace-with-a-long-random-password
# Keep the default unless 8080 is unavailable. If changed, update CORS_ORIGIN in docker-compose.staging.yml too.
ARTEDU_HTTP_PORT=8080
ARTEDU_ENV_LABEL=staging
CASE_VIDEO_MAX_MIB=100
# 教学课件视频上限，与案例视频同档位；其余课件（PDF/PPT/图片/网页源码）固定 10 MiB。
COURSE_VIDEO_MAX_MIB=100
# 默认只监听本机：通过 SSH 隧道（ssh -L 8080:127.0.0.1:8080）或校内反向代理访问。
# 只有网络评审通过、且确实需要直接对外暴露时才改为 0.0.0.0。
ARTEDU_BIND_IP=127.0.0.1
ARTEDU_CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080

# OSS is intentionally optional. Until it is configured, uploads are kept in the
# server's private Docker volume: users under users/<id>/ and course material
# under admin/courses/. No background OSS or SSO polling is performed.
# When OSS is funded and configured, add its credentials only to the server .env.

# Optional server-side DeepSeek integration. Fill the key only in the server's ignored .env.
# Enable only after configuring a funded provider account and user quotas.
MODEL_EXECUTION_ENABLED=false
# DeepSeek V4.1 Flash 支持 chat 与 vision；图像/图案生成仍交给下面的 ModelScope 文生图。
MODEL_PROVIDERS_JSON=[{"id":"model-deepseek-v4-flash","baseUrl":"https://api.deepseek.com","model":"deepseek-flash","capabilities":["chat","vision","webpage","document"],"apiKeyEnv":"DEEPSEEK_API_KEY","timeoutMs":180000},{"id":"model-modelscope-qwen-image","baseUrl":"https://api-inference.modelscope.cn","model":"Qwen/Qwen-Image","capabilities":["image","pattern"],"apiKeyEnv":"MODELSCOPE_API","timeoutMs":120000,"protocol":"modelscope-image","internal":true}]
DEEPSEEK_API_KEY=
# 备用 key：上面的 DEEPSEEK_API_KEY 失效/欠费（HTTP 401/402/403）时自动接管，
# 不需要改代码或重启。留空则行为与过去一致（主 key 不可用就直接报错）。
DEEPSEEK_API_KEY_FALLBACK=
# ModelScope（魔搭）文生图。密钥只写在服务器 .env，不进入镜像或前端包。
MODELSCOPE_API=
# 可选：OpenAI Images 兼容的校内或云端生图服务。不要同时在前端配置 Key。
# MODEL_PROVIDERS_JSON 中增加：{"id":"school-image-api","baseUrl":"https://image.example.edu/v1","model":"image-v1","capabilities":["image","pattern"],"apiKeyEnv":"IMAGE_API_KEY","timeoutMs":120000,"protocol":"openai-image","internal":true}
# IMAGE_API_KEY=

# RAG：使用 OpenAI-compatible embeddings 接口。只有四项均配置后才设为 true。
# 向量维度必须与 embedding 模型的实际输出维度一致；首次默认按 BGE-M3 的 1024 维配置。
RAG_ENABLED=false
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_DIMENSIONS=1024
RAG_MIN_SIMILARITY=0.62
# RAG 联网兜底开关：目前 RAG 只返回 webEvidence: []，该开关尚未被消费（保留待实现）。
RAG_WEB_FALLBACK_ENABLED=true

# 联网检索：DeepSeek 原生联网搜索（走 Anthropic 兼容 Messages 端点），
# 检索与正文抽取都在服务商侧完成，不需要本地检索服务或 Chromium 抓取器。
# 复用上面的 DEEPSEEK_API_KEY，只有端点不同；以下三项留空即使用默认值。
WEB_SEARCH_TIMEOUT_MS=25000
DEEPSEEK_SEARCH_BASE_URL=
DEEPSEEK_SEARCH_MODEL=
DEEPSEEK_SEARCH_MAX_USES=
