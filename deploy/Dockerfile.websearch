FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir "fastapi==0.116.1" "uvicorn[standard]==0.35.0" "ddgs==9.5.2" \
  && useradd --create-home --uid 10001 appuser
COPY services/websearch/app.py /app/app.py
USER appuser
EXPOSE 8081
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8081"]
