NODE_ENV=development
PORT=3000
APP_HOST=127.0.0.1

# Leave empty unless the browser client is served from a different origin.
# Example: CORS_ORIGINS=https://app.example.edu.cn
CORS_ORIGINS=
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

POSTGRES_USER=design_platform
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=design_platform
DATABASE_URL=postgresql://design_platform:replace_with_a_local_password@localhost:5432/design_platform?schema=public

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_local_password
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=design-platform
